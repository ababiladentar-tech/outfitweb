# Salin menjadi .env.local (lokal) atau isi di Vercel > Project > Settings > Environment Variables.
# Semua opsional. Tanpa Supabase, app berjalan di mode demo (localStorage).
# Tanpa Gemini, Stylist Agent memakai perencana lokal dengan tools yang sama.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google AI Studio > Get API key
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Batas konsultasi Stylist Agent per akun per hari. Hanya berlaku saat Supabase aktif;
# dijalankan lokal tanpa Supabase, chat tidak dibatasi. Isi keduanya dengan angka yang sama.
# AI_DAILY_LIMIT=10
# NEXT_PUBLIC_AI_DAILY_LIMIT=10
